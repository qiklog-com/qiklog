# CLI send demo — vhs send.tape (from repo tapes/)

Output ../www/public/demos/cli-send.gif

Set Shell "bash"
Set FontSize 14
Set Width 880
Set Height 420
Set Theme "Catppuccin Mocha"
Set Padding 24

Type "dotnet run --project src/QikLog.Cli -- send -s demo -m 'deploy finished' -l info"
Sleep 600ms
Enter
Sleep 2s
Type "# 202 Accepted"
Sleep 1500ms
