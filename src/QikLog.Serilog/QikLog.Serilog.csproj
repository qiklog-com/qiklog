<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>QikLog.Serilog</RootNamespace>
    <AssemblyName>QikLog.Serilog</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>QikLog.Serilog</PackageId>
    <Version>0.1.0</Version>
    <Description>Serilog sink that POSTs log events to QikLog ingest (POST /v1/logs).</Description>
    <PackageTags>serilog;qiklog;logging;sink</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://www.qiklog.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/qiklog-com/qiklog</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.PeriodicBatching" Version="5.0.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="QikLog.Serilog.Tests" />
    <InternalsVisibleTo Include="QikLog.Smoke.Tests" />
  </ItemGroup>
</Project>
