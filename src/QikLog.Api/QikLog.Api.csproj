<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>QikLog.Api</RootNamespace>
    <AssemblyName>QikLog.Api</AssemblyName>
    <UserSecretsId>qiklog-api-dev</UserSecretsId>
    <Version>0.8.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="QikLog.Api.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\QikLog.Core\QikLog.Core.csproj" />
    <ProjectReference Include="..\QikLog.Infrastructure\QikLog.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- SignalR is built into ASP.NET Core; no extra package needed for server side -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.1.4" />
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
    <PackageReference Include="Stripe.net" Version="47.0.0" />
  </ItemGroup>
</Project>
