@implements IAsyncDisposable
@using System.Collections.Concurrent
@using Microsoft.AspNetCore.Authentication
@using Microsoft.JSInterop
@inject Microsoft.Extensions.Options.IOptions<QikLogOptions> Options
@inject QikLog.Web.Services.QikLogApiClient Api
@inject IHttpContextAccessor HttpContextAccessor
@inject AuthenticationStateProvider AuthState
@using QikLog.Web.Services
@inject IJSRuntime JS
@inject ILogger<LiveTailPanel> Log
@using QikLog.Web.Demo

@*
  Shared live-tail panel used by /tail/{source} and /embed/tail/{source}.
  One SignalR client implementation; pages only choose chrome density.
*@

<div class="@(Compact ? "ql-live-tail ql-live-tail-compact" : "ql-live-tail")">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="@(Compact ? 8 : 12)" Class="@(Compact ? null : "ql-page-wide")">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Center">
            @if (!Compact)
            {
                <h2 style="margin: 0;">tail <code>@Source</code></h2>
                <FluentSpacer />
            }
            else
            {
                <span class="ql-live-badge" aria-live="polite">LIVE</span>
                <code class="ql-live-source">@Source</code>
                <FluentSpacer />
            }
            <span class="ql-live-status" data-state="@StatusText">@StatusText</span>
            @if (!Compact)
            {
                <FluentSwitch @bind-Value="@AutoScroll">Auto-scroll</FluentSwitch>
                <FluentSwitch @bind-Value="@ShowHistory">History</FluentSwitch>
                <FluentButton OnClick="ClearBuffer">Clear</FluentButton>
            }
        </FluentStack>

        @if (!string.IsNullOrEmpty(_connectionError))
        {
            <FluentMessageBar Intent="MessageIntent.Warning" Title="Live tail unavailable">
                @_connectionError
            </FluentMessageBar>
        }

        @if (!Compact && !string.IsNullOrEmpty(_historyError))
        {
            <FluentMessageBar Intent="MessageIntent.Warning" Title="History unavailable">
                @_historyError
            </FluentMessageBar>
        }

        <FluentCard Style="padding: 0; background: var(--ql-surface-ink); color: var(--ql-text-fg); border: 1px solid var(--ql-surface-border);">
            <div id="tail-viewport" class="ql-tail-viewport" style="@ViewportStyle">
                @if (_entries.Count == 0)
                {
                    <div style="opacity: 0.6; padding: 1rem;">
                        @if (LinkId is null)
                        {
                            <text>Waiting for logs on source <code>@Source</code>...</text>
                        }
                        else
                        {
                            <text>Waiting for your first line...</text>
                        }
                    </div>
                }
                else
                {
                    @foreach (var row in _entries)
                    {
                        <div @key="row.Sequence" style="display: flex; gap: 0.75rem; padding: 0.15rem 0;">
                            <span style="opacity: 0.5; white-space: nowrap;">@row.Entry.Timestamp.ToString("HH:mm:ss.fff")</span>
                            <span style="@LevelStyle(row.Entry.Level); font-weight: 600; min-width: 4rem;">@LevelLabel(row.Entry.Level)</span>
                            <span style="white-space: pre-wrap; word-break: break-word;">@row.Entry.Message</span>
                            @if (!string.IsNullOrEmpty(row.Note))
                            {
                                <span class="ql-tail-latency">@row.Note</span>
                            }
                        </div>
                    }
                }
            </div>
        </FluentCard>

        @if (!Compact)
        {
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Style="opacity: 0.7; font-size: 0.85rem;">
                <span>@_entries.Count entries buffered</span>
                <span>&middot;</span>
                <span>Buffer cap: @BufferCap (oldest drop)</span>
                @if (_historyLoaded > 0)
                {
                    <span>&middot;</span>
                    <span>@_historyLoaded history rows loaded</span>
                }
            </FluentStack>
        }
    </FluentStack>
</div>

@code {
    /// <summary>Source name subscribed on the SignalR hub (e.g. demo).</summary>
    [Parameter, EditorRequired]
    public string Source { get; set; } = "";

    /// <summary>When true, omit page chrome for marketing iframe embeds.</summary>
    [Parameter]
    public bool Compact { get; set; }

    /// <summary>Viewport height CSS value (default full-page 70vh; embed uses a shorter pane).</summary>
    [Parameter]
    public string ViewportHeight { get; set; } = "70vh";

    /// <summary>
    /// When true, subscribe with the server-side demo credential instead of the
    /// visitor's token or the shared hub key. The credential is not rendered.
    /// </summary>
    [Parameter]
    public bool UseDemoCredential { get; set; }

    /// <summary>
    /// When set, this panel tails an anonymous log link (<c>/l/{id}</c>) instead of a
    /// tenant source: history comes from the link, and the hub call is SubscribeLink.
    /// Pair it with <see cref="UseDemoCredential"/>; a link is never read with a visitor's token.
    /// </summary>
    [Parameter]
    public string? LinkId { get; set; }

    /// <summary>Called on the server when a line arrives over SignalR, before it is painted.</summary>
    [Parameter]
    public EventCallback<LogEntry> LineArrived { get; set; }

    /// <summary>
    /// When true, tell the parent window each flushed message via
    /// <c>qiklogEmbedNotify</c>. Only the marketing iframe sets this.
    /// The playground is compact and must not call that function.
    /// </summary>
    [Parameter]
    public bool NotifyEmbed { get; set; }

    /// <summary>Optional note for a row, resolved once when the row is appended.</summary>
    [Parameter]
    public Func<LogEntry, string?>? NoteFor { get; set; }

    private const int BufferCap = 500;
    private const int FlushIntervalMs = 100;

    private sealed record LogRow(long Sequence, LogEntry Entry, string? Note);

    private readonly List<LogRow> _entries = [];
    private readonly ConcurrentQueue<LogEntry> _incoming = new();
    private readonly List<string> _notifyQueue = [];
    private readonly CancellationTokenSource _cts = new();
    private Task? _flushLoop;
    private long _sequence;

    private HubConnection? _hub;
    private bool AutoScroll { get; set; } = true;
    private bool ShowHistory { get; set; } = true;
    private int _historyLoaded;
    private string? _connectionError;
    private string? _historyError;

    private string ViewportStyle =>
        $"height: {ViewportHeight}; overflow-y: auto; padding: 1rem; font-family: var(--ql-font-mono); font-size: 0.85rem; line-height: 1.5;";

    private string StatusText => _hub?.State switch
    {
        HubConnectionState.Connected => "connected",
        HubConnectionState.Connecting => "connecting",
        HubConnectionState.Reconnecting => "reconnecting",
        HubConnectionState.Disconnected => "disconnected",
        _ => _connectionError is null ? "connecting" : "disconnected"
    };


    protected override async Task OnInitializedAsync()
    {
        // A link's embed is opened right after the link is made, often after the first
        // line was sent, so links load what is already there even when compact.
        if (LinkId is not null || (ShowHistory && !Compact))
            await LoadHistoryAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _flushLoop = RunFlushLoopAsync();
        await ConnectAsync();
    }

    private async Task RunFlushLoopAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(FlushIntervalMs));
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
                await FlushAsync();
        }
        catch (OperationCanceledException)
        {
            // Page navigated away.
        }
    }

    private async Task FlushAsync()
    {
        if (_incoming.IsEmpty || _cts.IsCancellationRequested)
            return;

        await InvokeAsync(() =>
        {
            if (_cts.IsCancellationRequested)
                return;

            var appended = 0;
            while (_incoming.TryDequeue(out var entry))
            {
                _entries.Add(new LogRow(++_sequence, entry, NoteFor?.Invoke(entry)));
                if (NotifyEmbed)
                    _notifyQueue.Add(entry.Message);
                appended++;
            }

            if (appended == 0)
                return;

            TrimToCap();
            StateHasChanged();
            _ = NotifyParentAsync();
        });
    }

    private async Task NotifyParentAsync()
    {
        if (!NotifyEmbed || _notifyQueue.Count == 0)
            return;

        var batch = _notifyQueue.ToArray();
        _notifyQueue.Clear();
        try
        {
            // Cast so the string[] is one argument. params object[] would
            // otherwise hand each message to the function separately, and
            // the script bails out because the first argument is not an array.
            await JS.InvokeVoidAsync("qiklogEmbedNotify", (object)batch);
        }
        catch (JSException)
        {
            // The parent page has no listener. The row is already on screen.
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
            // Prerender / circuit not ready.
        }
    }

    private void TrimToCap()
    {
        if (_entries.Count > BufferCap)
            _entries.RemoveRange(0, _entries.Count - BufferCap);
    }

    private async Task ConnectAsync()
    {
        if (string.IsNullOrWhiteSpace(Options.Value.ApiBaseUrl))
            return;

        var baseUrl = Options.Value.ApiBaseUrl.TrimEnd('/');
        // The playground (UseDemoCredential) and embeds (Compact) always use the shared
        // demo credential, never a visitor's token. Everyone else: signed-in state from
        // AuthenticationStateProvider, because HttpContext can be null on an interactive
        // circuit and treating a signed-in user as anonymous would hand them the hub key.
        var demoOnly = UseDemoCredential || Compact;
        var hubApiKey = UseDemoCredential
            ? DemoCredentials.Resolve(Options.Value)
            : Options.Value.HubApiKey?.Trim();
        var authState = await AuthState.GetAuthenticationStateAsync();
        var isAuthenticated = !demoOnly && authState.User.Identity?.IsAuthenticated == true;
        var accessToken = isAuthenticated && HttpContextAccessor.HttpContext is { } http
            ? await http.GetTokenAsync("access_token")
            : null;

        // No hub-key retry for signed-in users: the hub key is the bootstrap tenant's
        // credential, and falling back to it would show them another tenant's logs.
        var credential = ApiCredentialPolicy.Choose(isAuthenticated, accessToken, hubApiKey, isEmbed: demoOnly);
        _hub = BuildHub(baseUrl, credential);

        try
        {
            await _hub.StartAsync();
            if (LinkId is { } linkId)
                await _hub.InvokeAsync("SubscribeLink", linkId);
            else
                await _hub.InvokeAsync("Subscribe", Source);
            _connectionError = null;
        }
        catch (Exception ex)
        {
            _connectionError = DescribeFailure(ex, signedIn: isAuthenticated && !Compact);
            await _hub.DisposeAsync();
            _hub = null;
        }

        StateHasChanged();
    }

    private HubConnection BuildHub(string baseUrl, ApiCredential credential)
    {
        var hub = new HubConnectionBuilder()
            .WithUrl($"{baseUrl}/hubs/logs", options =>
            {
                if (credential.Kind == ApiCredentialKind.None || credential.Value is not { } value)
                    return;

                options.AccessTokenProvider = () => Task.FromResult<string?>(value);
                // Hub key also goes in the header; Bearer survives proxies that strip
                // custom headers on negotiate/WebSocket.
                if (credential.Kind == ApiCredentialKind.HubApiKey)
                    options.Headers["X-QikLog-API-Key"] = value;
            })
            .WithAutomaticReconnect()
            .Build();

        hub.On<LogEntry>("LogReceived", entry =>
        {
            if (LineArrived.HasDelegate)
                _ = LineArrived.InvokeAsync(entry);
            _incoming.Enqueue(entry);
        });
        hub.Reconnected += _ => InvokeAsync(StateHasChanged);
        hub.Reconnecting += _ => InvokeAsync(StateHasChanged);
        hub.Closed += _ => InvokeAsync(StateHasChanged);
        return hub;
    }

    private static string DescribeFailure(Exception ex, bool signedIn) =>
        ex.Message.Contains("401", StringComparison.Ordinal)
            ? signedIn
                ? "Your session has expired. Sign out and sign in again to resume the live tail."
                : "The API rejected this connection. Sign in to tail your own sources."
            : $"Could not reach the log stream: {ex.Message}";

    private void ClearBuffer()
    {
        while (_incoming.TryDequeue(out _))
        {
        }

        _entries.Clear();
        _historyLoaded = 0;
        StateHasChanged();
    }

    private async Task LoadHistoryAsync()
    {
        try
        {
            var history = LinkId is { } linkId
                ? await Api.GetLinkLinesAsync(linkId, BufferCap, CancellationToken.None) ?? []
                : await Api.GetSourceHistoryAsync(Source, BufferCap, CancellationToken.None);

            foreach (var entry in history)
                _entries.Add(new LogRow(++_sequence, entry, null));

            TrimToCap();
            _historyLoaded = history.Count;
        }
        catch (Exception ex)
        {
            _historyLoaded = 0;
            _historyError = ex is HttpRequestException
                ? "Could not load stored history from the API."
                : $"Stored history could not be read: {ex.Message}";
            Log.LogWarning(ex, "History load failed for source {Source}", Source);
        }
    }

    private static string LevelLabel(LogLevel level) => level switch
    {
        LogLevel.Trace => "TRACE",
        LogLevel.Debug => "DEBUG",
        LogLevel.Info => "INFO",
        LogLevel.Warning => "WARN",
        LogLevel.Error => "ERROR",
        LogLevel.Critical => "CRIT",
        _ => level.ToString().ToUpperInvariant()
    };

    private static string LevelStyle(LogLevel level) => level switch
    {
        LogLevel.Trace => "color: var(--ql-level-trace);",
        LogLevel.Debug => "color: var(--ql-level-debug);",
        LogLevel.Info => "color: var(--ql-level-info);",
        LogLevel.Warning => "color: var(--ql-level-warning);",
        LogLevel.Error => "color: var(--ql-level-error);",
        LogLevel.Critical => "color: var(--ql-level-critical); text-shadow: 0 0 4px var(--ql-accent-teal-glow);",
        _ => ""
    };

    /// <summary>Appends a row the way a flushed SignalR line would. Tests use this.</summary>
    internal void AppendForTests(LogEntry entry)
    {
        _entries.Add(new LogRow(++_sequence, entry, NoteFor?.Invoke(entry)));
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        await _cts.CancelAsync();

        if (_hub is not null)
        {
            try
            {
                if (LinkId is { } linkId)
                    await _hub.InvokeAsync("UnsubscribeLink", linkId);
                else
                    await _hub.InvokeAsync("Unsubscribe", Source);
            }
            catch
            {
                // The connection may already be gone.
            }
            await _hub.DisposeAsync();
        }

        _cts.Dispose();
    }
}
