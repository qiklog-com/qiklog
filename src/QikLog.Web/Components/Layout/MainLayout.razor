@inherits LayoutComponentBase

<FluentLayout>
    <FluentHeader Class="ql-header ql-on-dark">
        <a class="ql-lockup" href="/" aria-label="QikLog home">
            <img src="brand/icon.svg" alt="" width="26" height="26" />
            <span class="ql-wordmark">qik<span class="ql-wordmark-accent">log</span><span class="ql-cursor" aria-hidden="true"></span></span>
        </a>
        <FluentSpacer />
        <nav class="ql-nav">
            <AuthorizeView>
                <Authorized>
                    <a class="ql-nav-link" href="/billing">Billing</a>
                    <a class="ql-nav-link" href="/logout">Sign out</a>
                </Authorized>
                <NotAuthorized>
                    <a class="ql-nav-link" href="/login">Sign in</a>
                </NotAuthorized>
            </AuthorizeView>
            <a class="ql-nav-link" href="/manage">Manage</a>
            <span class="ql-tag">pre-alpha</span>
        </nav>
    </FluentHeader>
    @* Dismissed with plain JS, not @onclick: the layout renders as static SSR
       even when the page inside it is interactive, so there is no circuit here
       to handle the event. Deliberately not persisted — it comes back on load. *@
    <div class="ql-notice" role="note">
        <span class="ql-notice-text"><strong>Demo environment</strong>, sample data only, auth in active development.</span>
        <button type="button" class="ql-notice-dismiss" aria-label="Dismiss this notice"
                onclick="this.closest('.ql-notice').remove()">&times;</button>
    </div>
    <FluentStack Class="main" Orientation="Orientation.Horizontal" Width="100%">
        <FluentBodyContent Class="body-content">
            <div class="content">
                @Body
            </div>
        </FluentBodyContent>
    </FluentStack>
    <FluentFooter Class="ql-footer">
        <span>QikLog &middot; <a href="https://qiklog.com">qiklog.com</a></span>
    </FluentFooter>
</FluentLayout>

<FluentToastProvider />
<FluentDialogProvider />
