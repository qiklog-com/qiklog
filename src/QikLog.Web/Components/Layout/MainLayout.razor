@inherits LayoutComponentBase

<FluentLayout>
    <FluentHeader>
        <img src="brand/icon.svg" alt="" width="28" height="28" style="margin-right: 0.6rem;" />
        <span class="ql-wordmark" style="font-size: 1.15rem;">qik<span class="ql-wordmark-accent">log</span></span>
        <FluentSpacer />
        <AuthorizeView>
            <Authorized>
                <FluentAnchor Href="/billing" Appearance="Appearance.Hypertext" Style="font-size: 0.9rem; margin-right: 0.75rem;">Billing</FluentAnchor>
            </Authorized>
            <NotAuthorized>
                <FluentAnchor Href="/login" Appearance="Appearance.Hypertext" Style="font-size: 0.9rem; margin-right: 0.75rem;">Sign in</FluentAnchor>
            </NotAuthorized>
        </AuthorizeView>
        <FluentAnchor Href="/manage" Appearance="Appearance.Hypertext" Style="font-size: 0.9rem;">Manage</FluentAnchor>
        <span style="opacity: 0.7; font-size: 0.85rem;">pre-alpha</span>
    </FluentHeader>
    <div class="ql-notice" role="note">
        <span><strong>Demo environment</strong>, sample data only, auth in active development.</span>
    </div>
    <FluentStack Class="main" Orientation="Orientation.Horizontal" Width="100%">
        <FluentBodyContent Class="body-content">
            <div class="content">
                @Body
            </div>
        </FluentBodyContent>
    </FluentStack>
    <FluentFooter>
        <span>QikLog &middot; <a href="https://qiklog.com">qiklog.com</a></span>
    </FluentFooter>
</FluentLayout>

<FluentToastProvider />
<FluentDialogProvider />
