@inherits LayoutComponentBase

@*
  Minimal chrome for marketing iframes. Same Blazor app, no nav/notice/footer.
*@
<div class="ql-embed-root">
    @Body
</div>
<script>
    window.qiklogEmbedNotify = function (messages) {
        if (!Array.isArray(messages)) return;
        for (const message of messages) {
            window.parent.postMessage({ type: 'qiklog-log', message: message }, '*');
        }
    };
</script>
