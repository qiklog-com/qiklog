@page "/login"
@rendermode InteractiveServer

<PageTitle>Sign in · QikLog</PageTitle>

<FluentCard Style="max-width: 420px; margin: 3rem auto; padding: 2rem;">
    <h2 style="margin-top: 0;">Sign in</h2>
