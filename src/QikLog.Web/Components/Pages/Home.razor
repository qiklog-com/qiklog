@page "/"
@rendermode InteractiveServer

<PageTitle>QikLog</PageTitle>

<div class="ql-page">
    @* aria-label keeps the split-colour wordmark from being read as "qik log". *@
    <h1 class="ql-hero-title ql-wordmark" aria-label="QikLog">qik<span class="ql-wordmark-accent">log</span><span class="ql-cursor" aria-hidden="true"></span></h1>

    <p class="ql-lede">
        Lightweight log tailing for developers who want to see what their app is doing right now —
        without setting up Datadog.
    </p>
    <p class="ql-muted">
        Send a log line with curl and watch it land on the tail page in real time.
    </p>

    <section class="ql-section">
        <h2 class="ql-section-title">Try it</h2>
        <pre class="ql-terminal"><span class="ql-terminal-prompt">$</span> curl -X POST http://localhost:5080/v1/logs \
    -H "Content-Type: application/json" \
    -d '{"source":"demo","level":"info","message":"hello from curl"}'</pre>

        <div class="ql-cta-row">
            <FluentAnchor Appearance="Appearance.Accent" Href="/tail/demo">
                Open live tail for "demo"
            </FluentAnchor>
            <FluentAnchor Appearance="Appearance.Outline" Href="/manage">
                Manage sources &amp; keys
            </FluentAnchor>
        </div>
    </section>
</div>
