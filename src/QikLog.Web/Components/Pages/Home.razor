@page "/"
@rendermode InteractiveServer
@inject Microsoft.Extensions.Options.IOptions<QikLogOptions> Options

<PageTitle>QikLog</PageTitle>

<div class="ql-page-wide">
    <h1 class="ql-hero-title">Try it now</h1>
    <p class="ql-lede">
        Copy the curl. The tail on the right is already waiting for source <code>demo</code>.
    </p>

    <div class="ql-demo-split">
        <section class="ql-demo-pane">
            <h2 class="ql-section-title">Send a line</h2>
            <pre class="ql-terminal"><span class="ql-terminal-prompt">$</span> @_curl</pre>
            <p class="ql-muted">
                Workspace is the shared demo source. Treat anything you send as public.
            </p>
        </section>
        <section class="ql-demo-pane">
            <h2 class="ql-section-title">Live tail</h2>
            <a class="ql-tail-wait" href="/tail/demo">
                <span class="ql-tail-wait-label">waiting for your first log line</span>
                <span class="ql-cursor" aria-hidden="true"></span>
            </a>
            <p class="ql-muted">
                <a href="/tail/demo">Open live tail for demo</a>
                · <a href="/manage">Manage sources and keys</a>
            </p>
        </section>
    </div>
</div>

@code {
    private string _curl = "";

    protected override void OnInitialized()
    {
        var opts = Options.Value;
        var api = string.IsNullOrWhiteSpace(opts.ApiBaseUrl)
            ? "http://127.0.0.1:5080"
            : opts.ApiBaseUrl.TrimEnd('/');
        var payload = """{"source":"demo","level":"info","message":"hello from curl"}""";
        if (!string.IsNullOrWhiteSpace(opts.HubApiKey))
        {
            _curl =
                $"curl -X POST {api}/v1/logs \\\n" +
                "  -H \"Content-Type: application/json\" \\\n" +
                $"  -H \"Authorization: Bearer {opts.HubApiKey}\" \\\n" +
                $"  -d '{payload}'";
        }
        else
        {
            _curl =
                $"curl -X POST {api}/v1/logs \\\n" +
                "  -H \"Content-Type: application/json\" \\\n" +
                $"  -d '{payload}'";
        }
    }
}
