@page "/embed/tail/{Source}"
@layout QikLog.Web.Components.Layout.EmbedLayout
@rendermode InteractiveServer
@using QikLog.Web.Components.Shared

<PageTitle>live @Source &middot; QikLog</PageTitle>

@* Viewport fills the iframe minus the LIVE header row, card border, and root padding
   (~60px measured), so the frame document itself never scrolls. Only the log list does. *@
<LiveTailPanel Source="@Source" Compact="true" NotifyEmbed="true" ViewportHeight="calc(100vh - 4rem)" />

@code {
    [Parameter] public string Source { get; set; } = "";
}
