@page "/embed/l/{Id}"
@layout QikLog.Web.Components.Layout.EmbedLayout
@rendermode InteractiveServer
@using QikLog.Core.Links
@using QikLog.Web.Components.Shared

@* Compact tail of a log link for the marketing page iframe. The log area fills the
   iframe under the LIVE header (4.5rem = embed padding + header + gap + border, with a little slack), so the panel itself
   never scrolls; only the lines do. *@

<PageTitle>log link &middot; QikLog</PageTitle>

@if (LogLinkId.IsValid(Id))
{
    <LiveTailPanel Source="your link"
                   LinkId="@Id"
                   Compact="true"
                   UseDemoCredential="true"
                   NotifyEmbed="true"
                   ViewportHeight="calc(100vh - 4.5rem)" />
}
else
{
    <p class="ql-muted">This log link is not valid.</p>
}

@code {
    [Parameter] public string Id { get; set; } = "";
}
