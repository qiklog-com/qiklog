---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PricingCard from '../components/PricingCard.astro';

const appUrl = (import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:5081').replace(/\/$/, '');
const tryUrl = `${appUrl}/`;
const billingUrl = `${appUrl}/billing`;
const signUpUrl = `${appUrl}/signup`;
---
<BaseLayout title="Pricing · QikLog" description="QikLog is free up to 10,000 log lines a month. Pro is $9/month for 500,000. Cancel anytime.">
  <SiteNav appUrl={tryUrl} />
  <main class="wrap container">
    <PricingCard billingUrl={billingUrl} signUpUrl={signUpUrl} />
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .wrap {
    padding: 3rem 0 4rem;
  }
</style>
