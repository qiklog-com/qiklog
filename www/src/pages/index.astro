---
import BaseLayout from '../layouts/BaseLayout.astro';
import Lockup from '../components/Lockup.astro';
import TailPreview from '../components/TailPreview.astro';
import LiveTailEmbed from '../components/LiveTailEmbed.astro';
import ScrollScene from '../components/ScrollScene.astro';
import SiteFooter from '../components/SiteFooter.astro';

const appUrl = (import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:5081').replace(/\/$/, '');
const tryUrl = `${appUrl}/`;

// Landing copy Option B + demo line 3 (founder vote).
const title = 'QikLog: see what your app is doing, live';
const description =
  'See what your app is doing, live. Add a log line from your code. Watch it stream in the browser. No signup.';
---
<BaseLayout title={title} description={description}>
  <main>
    {/* Scene 1: existing hero, unchanged copy */}
    <section class="hero container" id="scene-1">
      <div class="copy">
        <Lockup />
        <h1>See what your app is doing, live.</h1>
        <p class="lede">Add a log line from your code. Watch it stream in the browser. No signup.</p>
        <a href={tryUrl} class="btn btn-primary">Try it now</a>
        <p class="price-hint">$9/mo, cancel anytime.</p>
      </div>
      <div class="stage">
        <TailPreview />
      </div>
    </section>

    <ScrollScene id="scene-2" eyebrow="Ingest">
      <h2 class="scene-title">One POST. Any language.</h2>
      <ul class="tag-row" aria-label="Ingest options">
        <li>curl</li>
        <li>Serilog</li>
        <li>raw HTTP</li>
      </ul>
    </ScrollScene>

    <ScrollScene id="scene-3" eyebrow="Live">
      <h2 class="scene-title">It's already streaming.</h2>
      <LiveTailEmbed appUrl={appUrl} source="demo" />
    </ScrollScene>

    <ScrollScene id="scene-4" eyebrow="Path">
      <h2 class="scene-title">No dashboard to configure.</h2>
      <ol class="flow" aria-label="How logs move">
        <li>
          <span class="flow-mark" aria-hidden="true">1</span>
          <span class="flow-label">your code</span>
        </li>
        <li>
          <span class="flow-mark" aria-hidden="true">2</span>
          <span class="flow-label">QikLog</span>
        </li>
        <li>
          <span class="flow-mark" aria-hidden="true">3</span>
          <span class="flow-label">your browser</span>
        </li>
      </ol>
    </ScrollScene>

    <ScrollScene id="scene-5" eyebrow="Start">
      <h2 class="scene-title">See it on your app.</h2>
      <a href={tryUrl} class="btn btn-primary">Try it now</a>
      <p class="price-hint bottom-price">$9/mo, cancel anytime.</p>
    </ScrollScene>
  </main>

  <SiteFooter />

  <script>
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const scenes = document.querySelectorAll('[data-scene]');
    if (reduce) {
      scenes.forEach((el) => el.classList.add('no-motion', 'is-in'));
    } else if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -12% 0px', threshold: 0.18 }
      );
      scenes.forEach((el) => io.observe(el));
    } else {
      scenes.forEach((el) => el.classList.add('is-in'));
    }
  </script>
</BaseLayout>

<style>
  .hero {
    padding: 5.5rem 0 5rem;
    display: grid;
    grid-template-columns: minmax(16rem, 0.85fr) minmax(28rem, 1.35fr);
    gap: 2.75rem 3.25rem;
    align-items: center;
    max-width: 68rem;
  }

  .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .stage {
    justify-self: stretch;
    padding: 2.25rem 2.4rem;
    background: var(--ql-hairline);
  }

  h1 {
    margin: 0;
    font-family: var(--ql-font-display);
    font-weight: 800;
    font-size: clamp(2.1rem, 5vw, 3.15rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--ql-ink);
  }

  .lede {
    margin: -0.75rem 0 0;
    max-width: 28rem;
    font-size: 1.05rem;
    line-height: 1.45;
    color: var(--ql-ink-muted);
  }

  .price-hint {
    margin: -0.6rem 0 0;
    font-size: 0.9rem;
    color: var(--ql-ink-caption);
  }

  .bottom-price {
    margin: 1rem 0 0;
  }

  .scene-title {
    margin: 0 0 1.5rem;
    font-family: var(--ql-font-display);
    font-weight: 800;
    font-size: clamp(1.65rem, 3.5vw, 2.35rem);
    letter-spacing: -0.02em;
    color: var(--ql-ink);
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-row li {
    padding: 0.45rem 0.85rem;
    font-family: var(--ql-font-mono);
    font-size: 0.9rem;
    color: var(--ql-ink);
    border: 1px solid var(--ql-hairline);
    border-radius: var(--ql-radius-sm);
    background: var(--ql-paper);
  }

  .flow {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .flow li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 1.1rem 1rem;
    border: 1px solid var(--ql-hairline);
    border-radius: var(--ql-radius-sm);
  }

  .flow-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    font-family: var(--ql-font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ql-paper);
    background: var(--ql-rust);
    border-radius: var(--ql-radius-sm);
  }

  .flow-label {
    font-family: var(--ql-font-display);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    color: var(--ql-ink);
  }

  @media (max-width: 720px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: 3.5rem;
    }

    .stage {
      padding: 1.5rem 1.4rem;
    }

    .flow {
      grid-template-columns: 1fr;
    }
  }
</style>
