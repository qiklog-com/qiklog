---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import TailPreview from '../components/TailPreview.astro';
import LiveTailEmbed from '../components/LiveTailEmbed.astro';
import ScrollScene from '../components/ScrollScene.astro';
import TapeTerminal from '../components/TapeTerminal.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Lockup from '../components/Lockup.astro';

const appUrl = (import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:5081').replace(/\/$/, '');
const tryUrl = `${appUrl}/`;

const title = 'QikLog: see what your app is doing, live';
const description =
  'See what your app is doing, live. Add a log line from your code. Watch it stream in the browser. No signup.';
---
<BaseLayout title={title} description={description} snap>
  <SiteNav appUrl={appUrl} />
  <main>
    <section class="scene hero" id="scene-1" data-scene>
      <div class="hero-grid container">
        <div class="copy">
          <h1 data-enter="up">See what your app is doing, live.</h1>
          <p class="lede" data-enter="up" style="--enter-delay: 100ms">
            Add a log line from your code. Watch it stream in the browser. No signup.
          </p>
          <a href={tryUrl} class="btn btn-primary" data-enter="up" style="--enter-delay: 200ms">Try it now</a>
          <p class="price-hint" data-enter="up" style="--enter-delay: 300ms">$9/mo, cancel anytime.</p>
        </div>
        <div class="stage" data-enter="right" style="--enter-delay: 200ms">
          <TailPreview />
        </div>
      </div>
    </section>

    <ScrollScene id="scene-2" eyebrow="INGEST">
      <h1 class="scene-title" data-enter="up" style="--enter-delay: 100ms">One POST. From anywhere.</h1>
      <div data-enter="left" style="--enter-delay: 200ms">
        <TapeTerminal />
      </div>
      <p class="scene-caption" data-enter="up" style="--enter-delay: 300ms">All you need is a path to send.</p>
    </ScrollScene>

    <ScrollScene id="scene-3" eyebrow="LIVE">
      <h1 class="scene-title" data-enter="up" style="--enter-delay: 100ms">It's already streaming.</h1>
      <div data-enter="right" style="--enter-delay: 480ms">
        <LiveTailEmbed appUrl={appUrl} source="demo" />
      </div>
    </ScrollScene>

    <ScrollScene id="scene-4" eyebrow="PATH">
      <h1 class="scene-title" data-enter="up" style="--enter-delay: 100ms">No dashboard to configure.</h1>
      <ol class="path-cards" aria-label="How logs move">
        <li data-enter="up" style="--enter-delay: 200ms">
          <span class="path-num" aria-hidden="true">1</span>
          <span class="path-label">your code</span>
          <svg class="path-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8 6 3 12l5 6M16 6l5 6-5 6"
            ></path>
          </svg>
        </li>
        <li data-enter="up" style="--enter-delay: 300ms">
          <span class="path-num" aria-hidden="true">2</span>
          <span class="path-label">QikLog</span>
          <img class="path-icon path-icon-mark" src="/brand/qiklog-mark.svg" width="28" height="28" alt="" />
        </li>
        <li data-enter="up" style="--enter-delay: 400ms">
          <span class="path-num" aria-hidden="true">3</span>
          <span class="path-label">your browser</span>
          <svg class="path-icon" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3.25" y="4.25" width="17.5" height="15.5" rx="2" fill="none" stroke="currentColor" stroke-width="1.75"></rect>
            <path d="M3 8.5h18" fill="none" stroke="currentColor" stroke-width="1.75"></path>
            <circle cx="6.5" cy="6.25" r="0.7" fill="currentColor"></circle>
            <circle cx="9" cy="6.25" r="0.7" fill="currentColor"></circle>
            <circle cx="11.5" cy="6.25" r="0.7" fill="currentColor"></circle>
          </svg>
        </li>
      </ol>
      <p class="scene-caption quiet" data-enter="up" style="--enter-delay: 500ms">
        Prebuilt .NET integration included.
      </p>
    </ScrollScene>

    <ScrollScene id="scene-5">
      <div class="cta" data-enter="up">
        <Lockup size="nav" />
        <a href={tryUrl} class="btn btn-primary">Get started</a>
        <p class="price-hint">$9/mo, cancel anytime.</p>
      </div>
      <SiteFooter />
    </ScrollScene>
  </main>

  <button type="button" class="scroll-chevron" aria-label="See it live">
    <span aria-hidden="true"></span>
  </button>

  <script>
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const scenes = document.querySelectorAll('[data-scene]');
    const chevron = document.querySelector('.scroll-chevron');

    function markIn(el) {
      if (el.dataset.seen) return;
      el.dataset.seen = '1';
      el.classList.add('is-in');
    }

    if (scenes[0]) markIn(scenes[0]);

    if (reduce) {
      scenes.forEach((el) => {
        el.classList.add('no-motion');
        markIn(el);
      });
    } else if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              markIn(entry.target);
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.35 }
      );
      scenes.forEach((el) => io.observe(el));
    } else {
      scenes.forEach((el) => markIn(el));
    }

    function currentIndex() {
      let best = 0;
      let bestDist = Number.POSITIVE_INFINITY;
      scenes.forEach((el, i) => {
        const dist = Math.abs(el.getBoundingClientRect().top - 60);
        if (dist < bestDist) {
          bestDist = dist;
          best = i;
        }
      });
      return best;
    }

    function updateChevron() {
      if (!chevron) return;
      const last = currentIndex() >= scenes.length - 1;
      chevron.toggleAttribute('data-last', last);
      chevron.toggleAttribute('hidden', last);
      chevron.setAttribute('aria-hidden', last ? 'true' : 'false');
    }

    if (chevron) {
      const reveal = () => {
        chevron.classList.add('is-visible');
        updateChevron();
      };
      if (reduce) reveal();
      else window.setTimeout(reveal, 2000);

      chevron.addEventListener('click', () => {
        const next = scenes[currentIndex() + 1];
        next?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
        window.setTimeout(updateChevron, reduce ? 0 : 400);
      });

      window.addEventListener('scroll', updateChevron, { passive: true });
      window.addEventListener('scrollend', updateChevron, { passive: true });
      updateChevron();
    }
  </script>
</BaseLayout>

<style>
  .hero {
    min-height: calc(100svh - var(--ql-nav-height));
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    align-items: center;
    padding: 1.25rem 0 3.25rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(16rem, 0.85fr) minmax(28rem, 1.35fr);
    gap: 2.75rem 3.25rem;
    align-items: center;
    max-width: 68rem;
    width: 100%;
  }

  .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .stage {
    justify-self: stretch;
  }

  h1,
  .scene-title {
    margin: 0;
    font-family: var(--ql-font-display);
    font-weight: 800;
    font-size: clamp(2.1rem, 5vw, 3.15rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--ql-ink);
  }

  .scene-title {
    margin: 0 0 1.5rem;
    font-size: clamp(1.75rem, 4vw, 2.55rem);
  }

  .lede {
    margin: -0.75rem 0 0;
    max-width: 28rem;
    font-size: 1.05rem;
    line-height: 1.45;
    color: var(--ql-ink-muted);
  }

  .price-hint {
    margin: -0.6rem 0 0;
    font-size: 0.9rem;
    color: var(--ql-ink-caption);
  }

  .scene-caption {
    margin: 1.1rem 0 0;
    font-size: 0.95rem;
    color: var(--ql-ink-muted);
  }

  .scene-caption.quiet {
    color: var(--ql-ink-caption);
    font-size: 0.88rem;
  }

  .path-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .path-cards li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
    min-height: 9.5rem;
    padding: 1.15rem 1.05rem 1rem;
    background: var(--ql-paper);
    border: 1px solid var(--ql-hairline);
    border-radius: var(--ql-radius-sm);
    box-shadow: var(--ql-shadow-sm);
  }

  .path-num {
    font-family: var(--ql-font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ql-rust);
  }

  .path-label {
    font-family: var(--ql-font-display);
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
    color: var(--ql-ink);
  }

  .path-icon {
    margin-top: auto;
    width: 1.75rem;
    height: 1.75rem;
    color: var(--ql-ink-caption);
  }

  .path-icon-mark {
    display: block;
  }

  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    padding: 2rem 0 1.5rem;
  }

  .cta .btn-primary {
    box-shadow: var(--ql-shadow);
  }

  .scroll-chevron {
    position: fixed;
    left: 50%;
    bottom: 1.35rem;
    z-index: 40;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--ql-hairline) 70%, transparent);
    border-radius: 50%;
    background: color-mix(in srgb, var(--ql-paper) 55%, transparent);
    backdrop-filter: blur(10px);
    box-shadow: var(--ql-shadow-pop);
    cursor: pointer;
    opacity: 0;
    transform: translate(-50%, 8px) scale(0.4);
    pointer-events: none;
  }

  .scroll-chevron.is-visible {
    pointer-events: auto;
    animation:
      chevron-pop 720ms cubic-bezier(0.34, 1.45, 0.64, 1) both,
      chevron-bob 2.2s ease-in-out 720ms infinite;
  }

  .scroll-chevron.is-visible[data-last],
  .scroll-chevron[data-last],
  .scroll-chevron[hidden] {
    display: none;
    animation: none;
    opacity: 0;
    pointer-events: none;
  }

  .scroll-chevron span {
    width: 0.55rem;
    height: 0.55rem;
    border-right: 2px solid var(--ql-ink);
    border-bottom: 2px solid var(--ql-ink);
    transform: rotate(45deg) translate(-1px, -1px);
  }

  @keyframes chevron-pop {
    0% {
      opacity: 0;
      transform: translate(-50%, 14px) scale(0.35);
    }
    58% {
      opacity: 0.95;
      transform: translate(-50%, -6px) scale(1.22);
    }
    78% {
      transform: translate(-50%, 3px) scale(0.9);
    }
    100% {
      opacity: 0.78;
      transform: translate(-50%, 0) scale(1);
    }
  }

  @keyframes chevron-bob {
    0%,
    100% {
      transform: translate(-50%, 0) scale(1);
    }
    50% {
      transform: translate(-50%, 7px) scale(1);
    }
  }

  @media (max-width: 720px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .path-cards {
      grid-template-columns: 1fr;
    }

    .path-cards li {
      min-height: 0;
    }
  }

  @media (max-width: 375px) {
    .hero {
      padding-top: 0.75rem;
    }

    .copy {
      gap: 1.1rem;
    }

    h1,
    .scene-title {
      font-size: 1.85rem;
    }

    .lede {
      font-size: 0.95rem;
    }

    .btn-primary {
      width: 100%;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-chevron,
    .scroll-chevron.is-visible {
      animation: none;
      opacity: 0.78;
      transform: translate(-50%, 0) scale(1);
    }

    .scroll-chevron[data-last],
    .scroll-chevron[hidden] {
      display: none;
      opacity: 0;
    }
  }
</style>
