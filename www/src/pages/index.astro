---
import BaseLayout from '../layouts/BaseLayout.astro';
import Lockup from '../components/Lockup.astro';
import TailPreview from '../components/TailPreview.astro';
import SiteFooter from '../components/SiteFooter.astro';

const appUrl = (import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:5081').replace(/\/$/, '');
const tryUrl = `${appUrl}/`;
---
<BaseLayout>
  <main>
    <section class="hero container">
      <div class="copy">
        <Lockup />
        <h1>Log tailing that works in seconds. No signup.</h1>
        <a href={tryUrl} class="btn btn-primary">Try it now</a>
        <p class="price-hint">$9/mo, cancel anytime.</p>
      </div>
      <TailPreview />
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .hero {
    padding: 5rem 0 4rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 22rem);
    gap: 2.25rem 2.75rem;
    align-items: center;
    max-width: 56rem;
  }

  .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  h1 {
    margin: 0;
    font-family: var(--ql-font-display);
    font-weight: 800;
    font-size: clamp(2.1rem, 5vw, 3.15rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--ql-ink);
  }

  .price-hint {
    margin: -0.6rem 0 0;
    font-size: 0.9rem;
    color: var(--ql-ink-caption);
  }

  @media (max-width: 720px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: 3.5rem;
    }
  }
</style>
