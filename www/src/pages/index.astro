---
import BaseLayout from '../layouts/BaseLayout.astro';
import Lockup from '../components/Lockup.astro';
import TailPreview from '../components/TailPreview.astro';
import SiteFooter from '../components/SiteFooter.astro';

const appUrl = (import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:5081').replace(/\/$/, '');
const tryUrl = `${appUrl}/`;

// Landing copy Option B + demo line 3 (founder vote).
const title = 'QikLog: see what your app is doing, live';
const description =
  'See what your app is doing, live. Add a log line from your code. Watch it stream in the browser. No signup.';
---
<BaseLayout title={title} description={description}>
  <main>
    <section class="hero container">
      <div class="copy">
        <Lockup />
        <h1>See what your app is doing, live.</h1>
        <p class="lede">Add a log line from your code. Watch it stream in the browser. No signup.</p>
        <a href={tryUrl} class="btn btn-primary">Try it now</a>
        <p class="price-hint">$9/mo, cancel anytime.</p>
      </div>
      <div class="stage">
        <TailPreview />
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .hero {
    padding: 5.5rem 0 5rem;
    display: grid;
    grid-template-columns: minmax(16rem, 0.85fr) minmax(28rem, 1.35fr);
    gap: 2.75rem 3.25rem;
    align-items: center;
    max-width: 68rem;
  }

  .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .stage {
    justify-self: stretch;
    padding: 2.25rem 2.4rem;
    background: var(--ql-hairline);
  }

  h1 {
    margin: 0;
    font-family: var(--ql-font-display);
    font-weight: 800;
    font-size: clamp(2.1rem, 5vw, 3.15rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--ql-ink);
  }

  .lede {
    margin: -0.75rem 0 0;
    max-width: 28rem;
    font-size: 1.05rem;
    line-height: 1.45;
    color: var(--ql-ink-muted);
  }

  .price-hint {
    margin: -0.6rem 0 0;
    font-size: 0.9rem;
    color: var(--ql-ink-caption);
  }

  @media (max-width: 720px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: 3.5rem;
    }

    .stage {
      padding: 1.5rem 1.4rem;
    }
  }
</style>
