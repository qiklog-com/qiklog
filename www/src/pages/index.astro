---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import LinkHero from '../components/LinkHero.astro';
import SiteFooter from '../components/SiteFooter.astro';

const appUrl = (import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:5081').replace(/\/$/, '');
const apiUrl = (
  import.meta.env.PUBLIC_API_URL ?? (import.meta.env.PROD ? 'https://api.qiklog.com' : 'http://localhost:5080')
).replace(/\/$/, '');
const signUpUrl = `${appUrl}/signup`;

const title = 'QikLog: console.log for your server';
const description =
  'console.log for your server. Get a link. Send it a line. Watch it land. No account, no agent, no dashboard.';
---
<BaseLayout title={title} description={description}>
  <SiteNav appUrl={appUrl} />
  <main>
    <section class="hero container" id="log-link">
      <h1>console.log for your server.</h1>
      <p class="lede">Get a link. Send it a line. Watch it land.</p>
      <LinkHero appUrl={appUrl} apiUrl={apiUrl} />
    </section>

    <section class="facts container" aria-label="What QikLog is not, and what it costs">
      <ul class="not">
        <li><strong>No dashboard</strong> to configure.</li>
        <li><strong>No agent</strong> to install.</li>
        <li><strong>No query language</strong> to learn.</li>
      </ul>
      <p class="price">
        Free up to 10,000 lines a month. Pro is $9/mo, cancel anytime.
        <a href={signUpUrl}>Create a free account</a>
      </p>
      <p class="also">
        There is a <a href="/docs/serilog/">Serilog sink</a>, a <a href="/docs/cli/">CLI</a>, and
        <a href="/docs/log-links/">plain-text reads for terminals and coding agents</a>.
        Monitoring suites are for when it is serious. QikLog is for right now.
      </p>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    padding: 3rem 0 2.25rem;
  }

  h1 {
    margin: 0;
    font-family: var(--ql-font-display);
    font-weight: 800;
    font-size: clamp(2.2rem, 5.4vw, 3.4rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--ql-ink);
  }

  .lede {
    margin: -0.35rem 0 0.4rem;
    font-size: 1.2rem;
    line-height: 1.45;
    color: var(--ql-ink-muted);
  }

  .facts {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.75rem 0 3rem;
    border-top: 1px solid var(--ql-hairline);
  }

  .not {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 1rem;
    color: var(--ql-ink-muted);
  }

  .not strong {
    color: var(--ql-ink);
    font-weight: 600;
  }

  .price,
  .also {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--ql-ink-muted);
  }

  .also {
    font-size: 0.9rem;
    color: var(--ql-ink-caption);
  }

  .facts a {
    color: var(--ql-rust);
  }

  @media (max-width: 375px) {
    .hero {
      padding-top: 1.75rem;
    }

    h1 {
      font-size: 1.95rem;
    }

    .lede {
      font-size: 1.02rem;
    }
  }
</style>
