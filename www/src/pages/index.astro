---
import BaseLayout from '../layouts/BaseLayout.astro';
import Lockup from '../components/Lockup.astro';

const appUrl = import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:5081';
const tryUrl = `${appUrl.replace(/\/$/, '')}/`;
---
<BaseLayout>
  <main>
    <section class="hero container">
      <Lockup />
      <h1>Log tailing that works in seconds. No signup.</h1>
      <a href={tryUrl} class="btn btn-primary">Try it now</a>
    </section>
  </main>

  <footer class="footer container">
    <p class="footer-note">
      <a href="/docs/">Docs</a>
      · <a href="/docs/quickstart/">Quickstart</a>
      · <a href="/terms/">Terms</a>
      · <a href="/privacy/">Privacy</a>
      · © {new Date().getFullYear()} QikLog
    </p>
  </footer>
</BaseLayout>

<style>
  .hero {
    padding: 5rem 0 6rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    max-width: 42rem;
  }

  h1 {
    margin: 0;
    font-family: var(--ql-font-display);
    font-weight: 800;
    font-size: clamp(2.1rem, 5vw, 3.15rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--ql-ink);
  }

  .footer {
    padding: 1.5rem 0 3rem;
    border-top: 1px solid var(--ql-hairline);
  }

  .footer-note {
    margin: 0;
    font-size: 0.85rem;
    color: var(--ql-ink-caption);
  }

  .footer-note a {
    color: var(--ql-ink-caption);
  }
</style>
