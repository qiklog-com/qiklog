---
import TerminalFrame from './TerminalFrame.astro';

// Demo line option 3 (founder vote). Typewriter steps/max-width = message.length (15).
const message = 'JWT expired 401';
---
<TerminalFrame title="demo">
  <div class="preview" role="img" aria-label={`Example log line: 14:02:11 ERROR demo ${message}`}>
    <p class="log-line">
      <span class="log-ts">14:02:11</span>
      <span class="log-level is-error">ERROR</span>
      <span class="log-source">demo</span>
      <span class="log-msg msg">{message}</span><span class="cursor" aria-hidden="true"></span>
    </p>
  </div>
</TerminalFrame>

<style>
  .preview {
    width: 100%;
    min-height: 7.5rem;
  }

  .msg {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    max-width: 0;
    white-space: nowrap;
  }

  :global(#scene-1.is-in) .msg,
  :global(#scene-1.no-motion) .msg {
    animation: type 2.4s steps(15, end) forwards;
  }

  .cursor {
    display: inline-block;
    width: 0.5ch;
    height: 0.95em;
    margin-left: 1px;
    background: var(--ql-rust);
    vertical-align: -0.1em;
    animation: blink 1.1s steps(1, end) infinite;
  }

  @keyframes type {
    from {
      max-width: 0;
    }
    to {
      max-width: 15ch;
    }
  }

  @keyframes blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(#scene-1.is-in) .msg,
    :global(#scene-1.no-motion) .msg,
    .msg {
      animation: none;
      max-width: 15ch;
    }

    .cursor {
      animation: none;
      opacity: 1;
    }
  }
</style>
