---
import TerminalFrame from './TerminalFrame.astro';

const command =
  'curl -X POST https://api.qiklog.com/v1/logs \\\n' +
  '  -H "Content-Type: application/json" \\\n' +
  '  -H "Authorization: Bearer $QIKLOG_API_KEY" \\\n' +
  `  -d '{"source":"demo","level":"info","message":"hello from curl"}'`;
---
<TerminalFrame title="ingest" variant="tape">
  <pre class="tape-body"><code data-tape-target>{command}</code></pre>
</TerminalFrame>

<script define:vars={{ command }}>
  const CHAR_MS = 28;
  const root = document.querySelector('[data-tape]');
  const target = root?.querySelector('[data-tape-target]');
  const scene = document.getElementById('scene-2');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function finish() {
    if (!root || !target) return;
    target.textContent = command;
    root.classList.remove('is-typing');
    root.classList.add('is-settled');
  }

  function type() {
    if (!root || !target) return;
    if (reduce) {
      finish();
      return;
    }
    root.classList.add('is-typing');
    target.textContent = '';
    let i = 0;
    const tick = () => {
      i += 1;
      target.textContent = command.slice(0, i);
      if (i < command.length) window.setTimeout(tick, CHAR_MS);
      else finish();
    };
    tick();
  }

  function start() {
    if (!root || root.dataset.played) return;
    root.dataset.played = '1';
    type();
  }

  function sceneReady() {
    return !scene || scene.classList.contains('is-in') || scene.classList.contains('no-motion');
  }

  if (reduce || sceneReady()) {
    start();
  } else if (scene) {
    const mo = new MutationObserver(() => {
      if (sceneReady()) {
        start();
        mo.disconnect();
      }
    });
    mo.observe(scene, { attributes: true, attributeFilter: ['class'] });
    window.setTimeout(() => {
      mo.disconnect();
      start();
    }, 2500);
  }
</script>

<style>
  .tape-body {
    margin: 0;
    min-height: 7.5rem;
    font-family: var(--ql-font-mono);
    font-size: 0.82rem;
    line-height: 1.55;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>
