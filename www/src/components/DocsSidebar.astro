---
interface DocLink {
  slug: string;
  title: string;
}

interface Props {
  docs: DocLink[];
  currentSlug: string;
}

const { docs, currentSlug } = Astro.props;
---
<aside class="docs-sidebar glass glass-sm">
  <p class="sidebar-label">Documentation</p>
  <nav aria-label="Documentation">
    <ul>
      {docs.map((doc) => (
        <li>
          <a
            href={doc.slug === 'getting-started' ? '/docs/' : `/docs/${doc.slug}/`}
            class:list={[{ active: doc.slug === currentSlug }]}
          >
            {doc.title}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</aside>

<style>
  .docs-sidebar {
    padding: 1.25rem 1rem;
    position: sticky;
    top: 1rem;
    align-self: start;
  }

  .sidebar-label {
    margin: 0 0 0.75rem;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ql-accent-teal);
    font-weight: 600;
  }

  .docs-sidebar ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .docs-sidebar li {
    margin: 0.15rem 0;
  }

  .docs-sidebar a {
    display: block;
    padding: 0.4rem 0.6rem;
    border-radius: var(--ql-radius-sm);
    color: var(--ql-text-fg-muted);
    text-decoration: none;
    font-size: 0.92rem;
  }

  .docs-sidebar a:hover {
    color: var(--ql-text-fg-strong);
    background: rgba(255, 255, 255, 0.04);
  }

  .docs-sidebar a.active {
    color: var(--ql-accent-teal);
    background: rgba(45, 212, 191, 0.08);
  }
</style>
