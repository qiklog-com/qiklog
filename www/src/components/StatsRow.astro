---
import { heroStats } from '../lib/hero-stats';

const { median, medianLabel, showStreamCounter, streamCountUrl } = heroStats;
---
<div class="stats" data-stats data-show-stream={showStreamCounter ? '1' : '0'} data-stream-url={streamCountUrl}>
  <div class="stat">
    <p class="stat-value">{median}</p>
    <p class="stat-label">{medianLabel}</p>
  </div>
  {showStreamCounter && <div class="stat" data-stream-slot hidden></div>}
</div>

<script>
  const root = document.querySelector('[data-stats]');
  if (root instanceof HTMLElement && root.dataset.showStream === '1') {
    const url = root.dataset.streamUrl;
    const slot = root.querySelector('[data-stream-slot]');
    if (url && slot instanceof HTMLElement) {
      fetch(url)
        .then((res) => (res.ok ? res.json() : Promise.reject()))
        .then((body) => {
          const total = body?.total;
          if (typeof total !== 'number') return;
          slot.innerHTML =
            `<p class="stat-value">${total.toLocaleString('en-US')}</p>` +
            `<p class="stat-label">log lines streamed</p>`;
          slot.hidden = false;
        })
        .catch(() => {
          /* fail closed: keep hidden */
        });
    }
  }
</script>

<style>
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem 4rem;
    margin: 2.5rem 0 0;
    padding-top: 1.75rem;
    border-top: 1px solid var(--ql-hairline);
  }

  .stat-value {
    margin: 0;
    font-family: var(--ql-font-mono);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--ql-ink);
    line-height: 1.1;
  }

  .stat-label {
    margin: 0.35rem 0 0;
    max-width: 16rem;
    font-size: 0.82rem;
    color: var(--ql-ink-caption);
    line-height: 1.35;
  }
</style>
