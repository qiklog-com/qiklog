---
interface Props {
  billingUrl: string;
  signUpUrl: string;
}

const { billingUrl, signUpUrl } = Astro.props;
---
<section class="pricing" id="pricing">
  <p class="eyebrow">Pricing</p>
  <h1>Start free. Upgrade when it's real.</h1>

  <div class="tier">
    <h2>Free</h2>
    <p class="price"><span>$0</span></p>
    <ul>
      <li>10,000 log lines a month</li>
      <li>Live tail in the browser</li>
      <li>API keys, CLI, Serilog sink</li>
    </ul>
    <a class="btn btn-outline" href={signUpUrl}>Create a free account</a>
  </div>

  <div class="tier">
    <h2>Pro</h2>
    <p class="price"><span>$9</span>/month</p>
    <ul>
      <li>500,000 log lines a month</li>
      <li>Everything in Free</li>
      <li>Cancel anytime from Billing; Pro lasts to the end of the month you paid for</li>
    </ul>
    <a class="btn btn-primary" href={billingUrl}>Upgrade to Pro</a>
  </div>

  <p class="fineprint">
    Over your limit, new lines are paused until next month or until you upgrade. Your existing logs always stay readable.
  </p>
</section>

<style>
  .pricing {
    max-width: 36rem;
  }

  .tier {
    margin: 0 0 1.75rem;
    padding: 1.25rem 1.4rem;
    border: 1px solid var(--ql-hairline);
    border-radius: 12px;
  }

  .tier h2 {
    margin: 0 0 0.25rem;
    font-family: var(--ql-font-display);
    font-size: 1.2rem;
  }

  .eyebrow {
    margin: 0 0 0.4rem;
    font-family: var(--ql-font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ql-rust);
  }

  h1 {
    margin: 0 0 0.75rem;
    font-family: var(--ql-font-display);
    font-weight: 800;
    font-size: 1.75rem;
    letter-spacing: -0.01em;
  }

  .price {
    margin: 0 0 0.75rem;
    color: var(--ql-ink-muted);
  }

  .price span {
    font-family: var(--ql-font-display);
    font-weight: 800;
    font-size: 2.5rem;
    letter-spacing: -0.03em;
    color: var(--ql-ink);
  }

  .blurb {
    margin: 0 0 1rem;
    color: var(--ql-ink-muted);
    max-width: 42ch;
  }

  ul {
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
    color: var(--ql-ink);
  }

  li {
    padding: 0.25rem 0;
  }

  li::before {
    content: "";
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.55rem;
    background: var(--ql-rust);
    border-radius: 1px;
    vertical-align: middle;
  }

  .fineprint {
    margin: 0.85rem 0 0;
    font-size: 0.85rem;
    color: var(--ql-ink-caption);
    max-width: 46ch;
  }
</style>
