---
import Lockup from './Lockup.astro';

interface Props {
  appUrl: string;
}

const { appUrl } = Astro.props;
const path = Astro.url.pathname;
const onDocs = path.startsWith('/docs');
---
<header class="nav container">
  <Lockup size="nav" />
  <nav class="nav-links" aria-label="Primary">
    <a href="/docs/" class:list={[{ active: onDocs }]}>Docs</a>
    <a href="/#pricing">Pricing</a>
    <a href={appUrl} class="btn btn-primary">Try it now</a>
  </nav>
</header>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 0 0;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.95rem;
  }

  .nav-links a:not(.btn) {
    color: var(--ql-ink-muted);
    text-decoration: none;
    font-weight: 500;
  }

  .nav-links a:not(.btn):hover,
  .nav-links a.active:not(.btn) {
    color: var(--ql-ink);
  }
</style>
