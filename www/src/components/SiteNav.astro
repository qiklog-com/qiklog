---
import Wordmark from './Wordmark.astro';

interface Props {
  appUrl: string;
}

const { appUrl } = Astro.props;
const path = Astro.url.pathname;
const onDocs = path.startsWith('/docs');
---
<header class="nav glass glass-sm container">
  <a href="/" class="nav-brand">
    <Wordmark />
  </a>
  <nav class="nav-links" aria-label="Primary">
    <a href="/#features" class:list={[{ active: !onDocs }]}>Features</a>
    <a href="/docs/" class:list={[{ active: onDocs }]}>Docs</a>
    <a href="/#pricing">Pricing</a>
    <a href={appUrl} class="btn btn-primary">Open app</a>
  </nav>
</header>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.25rem;
    padding: 0.85rem 1.25rem;
  }

  .nav-brand {
    text-decoration: none;
    color: inherit;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.9rem;
  }

  .nav-links a:not(.btn) {
    color: var(--ql-text-fg-muted);
    text-decoration: none;
  }

  .nav-links a:not(.btn):hover,
  .nav-links a.active:not(.btn) {
    color: var(--ql-text-fg-strong);
  }

  .nav-links a.active:not(.btn) {
    border-bottom: 1px solid var(--ql-accent-teal);
    padding-bottom: 0.1rem;
  }
</style>
