---
import TerminalFrame from './TerminalFrame.astro';

/**
 * Real live tail: iframe to the Blazor LiveTailPanel at /embed/tail/{source}.
 * Lazy-loaded so the hero does not pay the Blazor circuit cost up front.
 */
interface Props {
  appUrl: string;
  source?: string;
}

const { appUrl, source = 'demo' } = Astro.props;
const origin = appUrl.replace(/\/$/, '');
const embedUrl = `${origin}/embed/tail/${encodeURIComponent(source)}`;
---
<div class="live-frame">
  <TerminalFrame title="demo · tail">
    <div class="live-stage">
      <ul class="live-skeleton" data-live-skeleton aria-hidden="true">
        <li class="log-line">
          <span class="log-ts">14:02:11</span>
          <span class="log-level is-info">INFO</span>
          <span class="log-source">{source}</span>
          <span class="log-msg">200 GET /api/orders 24.31ms</span>
        </li>
        <li class="log-line">
          <span class="log-ts">14:02:12</span>
          <span class="log-level is-warn">WARN</span>
          <span class="log-source">{source}</span>
          <span class="log-msg">401 POST /api/checkout</span>
        </li>
      </ul>
      <iframe
        class="live-iframe"
        title={`Live tail for ${source}`}
        src={embedUrl}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allow="clipboard-write"
        onload="this.previousElementSibling.setAttribute('hidden','')"
      ></iframe>
    </div>
  </TerminalFrame>
  <p class="live-note">
    Same panel as <a href={`${origin}/tail/${encodeURIComponent(source)}`}>/tail/{source}</a>.
    Send a line to this source and it appears here.
  </p>
</div>

<style>
  .live-frame {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .live-stage {
    position: relative;
    min-height: 18.5rem;
  }

  .live-skeleton {
    position: absolute;
    inset: 0;
    z-index: 1;
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .live-skeleton[hidden] {
    display: none;
  }

  .live-iframe {
    display: block;
    width: 100%;
    min-height: 18.5rem;
    border: 0;
    background: var(--ql-ink);
  }

  .live-note {
    margin: 0;
    font-size: 0.85rem;
    color: var(--ql-ink-caption);
  }

  .live-note a {
    color: var(--ql-rust);
  }

  @media (max-width: 375px) {
    .live-stage,
    .live-iframe {
      min-height: 14rem;
    }
  }
</style>
