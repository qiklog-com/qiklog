---
/**
 * One full-viewport snap slide. Parent IntersectionObserver adds .is-in once.
 */
interface Props {
  id?: string;
  eyebrow?: string;
}

const { id, eyebrow } = Astro.props;
---
<section class="scene" id={id} data-scene>
  <div class="scene-inner container">
    {eyebrow && (
      <p class="scene-eyebrow" data-enter="up">{eyebrow}</p>
    )}
    <slot />
  </div>
</section>

<style>
  .scene {
    min-height: calc(100svh - var(--ql-nav-height));
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1.25rem 0 3.25rem;
  }

  .scene-inner {
    width: 100%;
    max-width: 52rem;
  }

  .scene-eyebrow {
    margin: 0 0 0.75rem;
    font-family: var(--ql-font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ql-rust);
  }

  :global([data-enter]) {
    opacity: 0;
  }

  :global([data-enter='up']) {
    transform: translateY(12px);
  }

  :global([data-enter='left']) {
    transform: translateX(-2.25rem);
  }

  :global([data-enter='right']) {
    transform: translateX(2.25rem);
  }

  :global(.is-in [data-enter]),
  :global(.no-motion [data-enter]) {
    opacity: 1;
    transform: none;
    transition:
      opacity 260ms ease,
      transform 260ms ease;
    transition-delay: var(--enter-delay, 0ms);
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-enter]) {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
