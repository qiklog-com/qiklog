---
import BaseLayout from './BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import DocsSidebar from '../components/DocsSidebar.astro';
import DocPager from '../components/DocPager.astro';

interface DocLink {
  slug: string;
  title: string;
}

interface Props {
  title: string;
  description: string;
  currentSlug: string;
  docs: DocLink[];
}

const { title, description, currentSlug, docs } = Astro.props;
const appUrl = import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:5081';
const pageTitle = `${title} · Docs · QikLog`;
---
<BaseLayout title={pageTitle} description={description}>
  <SiteNav appUrl={appUrl} />
  <div class="docs-shell container">
    <DocsSidebar docs={docs} currentSlug={currentSlug} />
    <article class="docs-article glass">
      <header class="docs-header">
        <p class="docs-eyebrow">Documentation</p>
        <h1>{title}</h1>
        <p class="docs-lead">{description}</p>
      </header>
      <div class="docs-prose">
        <slot />
        <DocPager docs={docs} currentSlug={currentSlug} />
      </div>
    </article>
  </div>
  <footer class="footer container">
    <p class="footer-note">
      <a href="/">Home</a>
      · <a href="/docs/">Docs</a>
      · © {new Date().getFullYear()} QikLog
    </p>
  </footer>
</BaseLayout>

<style>
  .docs-shell {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 1.5rem;
    padding: 1.5rem 0 3rem;
    align-items: start;
  }

  @media (max-width: 800px) {
    .docs-shell {
      grid-template-columns: 1fr;
    }
  }

  .docs-article {
    padding: 2rem 2.25rem;
    min-width: 0;
  }

  .docs-header {
    margin-bottom: 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--glass-border);
  }

  .docs-eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ql-accent-teal);
    font-weight: 600;
  }

  .docs-header h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    color: var(--ql-text-fg-strong);
  }

  .docs-lead {
    margin: 0;
    color: var(--ql-text-fg-muted);
    font-size: 1.05rem;
    max-width: 60ch;
  }

  .footer {
    padding: 1.5rem 0 2.5rem;
    border-top: 1px solid var(--glass-border);
  }

  .footer-note {
    margin: 0;
    font-size: 0.85rem;
    color: var(--ql-text-fg-muted);
  }

  .footer-note a {
    color: var(--ql-text-fg-muted);
  }
</style>

<style is:global>
  .docs-prose {
    color: var(--ql-text-fg);
    line-height: 1.7;
    max-width: 72ch;
  }

  .docs-prose h2 {
    margin: 2rem 0 0.75rem;
    font-size: 1.35rem;
    color: var(--ql-text-fg-strong);
  }

  .docs-prose h3 {
    margin: 1.5rem 0 0.5rem;
    font-size: 1.1rem;
    color: var(--ql-text-fg-strong);
  }

  .docs-prose p,
  .docs-prose li {
    color: var(--ql-text-fg-muted);
  }

  .docs-prose a {
    color: var(--ql-accent-teal);
  }

  .docs-prose code {
    font-family: var(--ql-font-mono);
    font-size: 0.88em;
    background: rgba(0, 0, 0, 0.25);
    padding: 0.12em 0.35em;
    border-radius: var(--ql-radius-sm);
    color: var(--ql-text-fg);
  }

  .docs-prose pre {
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid var(--glass-border);
    border-radius: var(--ql-radius-lg);
    padding: 1rem 1.15rem;
    overflow-x: auto;
    margin: 1rem 0;
  }

  .docs-prose pre code {
    background: none;
    padding: 0;
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .docs-prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
    font-size: 0.92rem;
  }

  .docs-prose th,
  .docs-prose td {
    border: 1px solid var(--glass-border);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }

  .docs-prose th {
    color: var(--ql-text-fg-strong);
    background: rgba(0, 0, 0, 0.2);
  }

  .docs-prose ul,
  .docs-prose ol {
    padding-left: 1.25rem;
    margin: 0.5rem 0 1rem;
  }

  .docs-prose li {
    margin: 0.35rem 0;
  }

  .docs-prose hr {
    border: none;
    border-top: 1px solid var(--glass-border);
    margin: 2rem 0;
  }

  .docs-prose strong {
    color: var(--ql-text-fg-strong);
  }
</style>
