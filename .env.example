# Copy to .env and fill in. ACR/Postgres names must be globally unique (lowercase alphanumeric).

# Stable suffix for Azure resource names (e.g. qiklogacra1b2c3d4e5)
QIKLOG_SEED=a1b2c3d4e5

# Azure auth — pick one:
# 1) Run `az login` locally (recommended for setup)
# 2) Service principal (CI / automation):
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=
# 3) User/password (legacy; avoid if possible):
# AZ_USERNAME=
# AZ_PASSWORD=

LOCATION=eastus2
RESOURCE_GROUP=qiklog-prod

# Set full names (do not rely on shell expansion in .env)
ACR_NAME=qiklogacra1b2c3d4e5
ENV_NAME=qiklog-env
API_APP_NAME=qiklog-api
WEB_APP_NAME=qiklog-web
IMAGE_TAG=latest

# App does not use Postgres yet — keep true to save ~$13/mo until #14
SKIP_POSTGRES=true

# When SKIP_POSTGRES=false:
PG_SERVER=qiklog-pg-a1b2c3d4e5
PG_ADMIN=qiklogadmin
PG_PASSWORD=ChangeMe!StrongP@ssw0rd
PG_DB=qiklog
